# Copy to `.env` (or `.env.local`) — Expo auto-loads it.
# EXPO_PUBLIC_* vars are inlined into the client bundle, so never put secrets here.

# zero-cache endpoint (the Zero sync server). Leave empty to run Zero local-only.
EXPO_PUBLIC_ZERO_SERVER=

# Your Go API base URL (auth, custom mutators / push endpoint).
EXPO_PUBLIC_API_URL=http://localhost:8080

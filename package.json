{
  "name": "barkly",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run --filter '*' check",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "mobile": "bun run --filter barkly-mobile start",
    "server": "bun run --filter barkly-back dev",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "trustedDependencies": [
    "@rocicorp/zero-sqlite3",
    "protobufjs",
    "unrs-resolver"
  ]
}

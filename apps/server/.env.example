# Copy to .env and fill in. The process fails fast on missing/invalid values.
NODE_ENV=development
PORT=3000

# Postgres (Zero replicates this; needs wal_level=logical)
DATABASE_URL=postgresql://barkly:barkly@localhost:5432/barkly

# JWT signing secret — anonymous-first auth. zero-cache must share this.
JWT_SECRET=change-me-dev-only

# Object Storage (media bucket). S3-compatible. Only the ingestion pipeline
# needs these; the API boots without them. Values from Terraform outputs:
#   terraform -chdir=infra/terraform output -raw storage_access_key
#   terraform -chdir=infra/terraform output -raw storage_secret_key
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=barkly-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Anthropic — ingestion LLM stages (classify, lesson). Provide ONE of:
#   ANTHROPIC_API_KEY   — sk-ant-… from https://console.anthropic.com (recommended)
#   ANTHROPIC_AUTH_TOKEN — OAuth bearer (e.g. `ant auth print-credentials --access-token`).
#     Subscription tokens are scoped to Claude Code and may be rejected for direct
#     API use; short-lived, not auto-refreshed. For local testing only.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-haiku-4-5
# LLM backend: "api" (Messages API, needs key+credits) or "claude_cli" (shells
# out to `claude -p`, uses a Claude subscription, no API credits — local test
# only: slower, best-effort JSON). Defaults to "api".
LLM_PROVIDER=api
CLAUDE_CLI_BIN=claude

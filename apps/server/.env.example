# Copy to .env and fill in. The process fails fast on missing/invalid values.
NODE_ENV=development
PORT=3000

# Postgres (Zero replicates this; needs wal_level=logical)
DATABASE_URL=postgresql://barkly:barkly@localhost:5432/barkly

# JWT signing secret — anonymous-first auth. zero-cache must share this.
JWT_SECRET=change-me-dev-only

# Object Storage (media bucket). S3-compatible. Values from Terraform outputs:
#   terraform -chdir=infra/terraform output -raw storage_access_key
#   terraform -chdir=infra/terraform output -raw storage_secret_key
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=barkly-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

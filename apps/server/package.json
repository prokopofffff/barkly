{
  "name": "barkly-back",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "zero:generate": "drizzle-zero generate -s src/db/schema.ts -o ../../packages/zero/src/schema.gen.ts --enable-legacy-queries --suppress-defaults-warning -f",
    "zero:deploy-perms": "zero-deploy-permissions -p src/zero/schema-config.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@barkly/zero": "workspace:*",
    "@rocicorp/zero": "^1.5.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "jose": "^6.2.3",
    "pg-boss": "^12.18.2",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "drizzle-zero": "^0.18.0",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}

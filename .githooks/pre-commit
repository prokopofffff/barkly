#!/bin/sh
# Barkly monorepo pre-commit gate. Enabled via `core.hooksPath .githooks` (set by
# the root "prepare" script on `bun install`). Runs typecheck + lint across every
# workspace (apps/mobile, apps/server, …). Bypass once with: git commit --no-verify
set -e

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found — install Bun (https://bun.sh) and retry." >&2
  exit 1
fi

echo "pre-commit: check all workspaces…"
bun run check

echo "pre-commit: ok"
